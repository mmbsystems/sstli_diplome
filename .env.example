AUTH_SECRET=replace-with-a-long-random-secret

# Explicit read source. Static remains the default; Supabase errors never fall back.
ADMIN_DATA_SOURCE=static
# Optional hosted read configuration. Static mode does not require Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Preferred for new projects; falls back to the legacy anon key above.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only elevated credential: prefer a modern secret; never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Legacy alternative; never supply a user JWT or an anon key here.
SUPABASE_SERVICE_ROLE_KEY=
# Isolated proof command remains disabled by default; no editor uses it.
ADMIN_WRITE_PROBE_ENABLED=false
ADMIN_WRITE_PROBE_PROJECT_REF=
